# Copiez ce fichier en .env puis lancez : node --env-file=.env src/server.js
NODE_ENV=production
PORT=3000
# Générez un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# Chemin de la base SQLite (défaut : data/holonet.db)
# DB_FILE=./data/holonet.db
# Nombre de proxys devant l'app (ex. 1 derrière Nginx) pour les cookies sécurisés et la limitation de débit
# TRUST_PROXY=1
